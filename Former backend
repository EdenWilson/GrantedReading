    url = 'http://localhost:11434/api/chat'
    user = ""
    messages = []
    user = myprompt
    messages.append({"role": "user", "content": user}) 
    prompt = {
                "model": "myWorksheetMaker:v3",
                "messages": messages,
                "stream": False
            }
    print("Generating text and questions...")
    try:
        x = requests.post(url, json=prompt)
        response = x.json()
