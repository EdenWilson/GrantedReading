# ---------- Parsing function ----------
def parse_worksheet(output_text):
    """
    Parses LLM output into title, story, and 5 separate questions.
    First line = title
    Last 5 lines ending with '?' = questions
    Everything in between = story
    """
    output_text = output_text.replace("*", "")
    lines = [line.strip() for line in output_text.splitlines() if line.strip()]

    if len(lines) < 7:
        raise ValueError("Output too short to parse")

    # Title = first line
    title = lines[0]

    # Find last 5 question lines (ending with ?)
    question_indices = [i for i, line in enumerate(lines) if line.endswith("?")]
    if len(question_indices) < 5:
        raise ValueError("Not enough question lines detected")
    last_five_q_indices = question_indices[-5:]
    questions = [lines[i] for i in last_five_q_indices]

    # Story = everything between title and first question
    story_start = 1
    story_end = last_five_q_indices[0]
    story_lines = lines[story_start:story_end]
    story = "\n\n".join(story_lines)

    # Return structured JSON
    return {
        "Title": title,
        "Story": story,
        "Who": questions[0],
        "What": questions[1],
        "When": questions[2],
        "Where": questions[3],
        "Why": questions[4]
    }

