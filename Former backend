def generate_jwt():
    """
    Generate a JWT token for PDF Generator API with required 'iss' and 'sub'.
    """
    payload = {
        "iss": API_KEY,               # Issuer
        "sub": API_KEY,               # Subject (required)
        "exp": int(time.time()) + 60  # Token valid for 60 seconds
    }
    token = jwt.encode(payload, SECRET_KEY, algorithm="HS256")
    return token

def send_to_pdf_api(parsed_json, run_folder):
    """
    Sends a hardcoded worksheet to the PDF Generator API,
    downloads the PDF, and saves it with a timestamped filename.
    """
    jwt_token = generate_jwt()  # Generate JWT
    
    #print(parsed_json)
    #information to send to the API
    payload = {
        "template": {
            "id": "1120770",  # template ID
            "data": [
                parsed_json
            ]
        },
        "format": "pdf",
        "output": "url"
    }

    headers = {
        "Authorization": f"Bearer {jwt_token}",
        "Content-Type": "application/json"
    }

    response = requests.post(PDF_API_URL, headers=headers, json=payload)

